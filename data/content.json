            "items": [
              {
                "question": "What is event planning?",
                "answer": "Event planning is the process of organizing and managing all details of an event, including venue, decoration, catering, entertainment, and coordination, to ensure a smooth and memorable experience."
              },
              {
                "question": "How long does it take to plan an event?",
                "answer": "It depends on the scale of the event. Small parties may take a few weeks, while large events like weddings can take several months of planning."
              },
              {
                "question": "What types of events do you plan?",
                "answer": "We specialize in birthday parties, anniversaries, corporate events, baby showers, and specialized themed events."
              },
              {
                "question": "What is included in your event planning services?",
                "answer": "Our services include venue selection, theme and decor setup, catering coordination, entertainment booking, and on-site management."
              },
              {
                "question": "Do you provide wedding planning services?",
                "answer": "While we specialize in birthdays, we also have partners and dedicated packages for complete wedding planning and coordination."
              },
              {
                "question": "Can you handle both small and large events?",
                "answer": "Absolutely! We scale our team and resources based on the size and requirements of your event."
              }
            ]
          }
        }
